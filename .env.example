# ── Database ──────────────────────────
# Direct (Railway / pipeline)
DATABASE_URL=postgresql://user:pass@db.supabase.co:5432/postgres

# Pooled (Vercel / API)
# Supabase: Dashboard → Database → Connection Pooling → Transaction mode
DATABASE_URL_POOLED=postgresql://user:pass@db.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1

# ── LLM API Keys ──────────────────────
OPEN_AI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_CLAUDE_API_KEY=

# ── Runtime ───────────────────────────
# true  → API / Vercel (serverless)
# false → pipeline / Railway (persistent)
USE_POOLED_DB=false
