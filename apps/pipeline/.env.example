# Supabase direct connection (pipeline)
DATABASE_URL=postgresql://user:pass@db.supabase.co:5432/postgres

# Alternative: build URL from Supabase env vars
SUPABASE_DB_HOST_URL=db.supabase.co
SUPABASE_DB_PASSWORD=your-password

# LLM API keys
OPEN_AI_API_KEY=sk-...
GEMINI_API_KEY=...
PERPLEXITY_API_KEY=pplx-...
ANTHROPIC_CLAUDE_API_KEY=sk-ant-...

# Pipeline uses direct (not pooled) connection
USE_POOLED_DB=false

# TrueSync catalog reads (clients/truesync_catalog.py) — the study
# generator grounds catalog questions in these. The tenant token from
# parleo-supply-app's scripts/tenants.py, sent as X-TrueSync-Key. Without
# it the upstream answers 403 and catalog-grounded generation FAILS the
# job rather than producing an ungrounded study.
TRUESYNC_API_BASE=https://api.parleo.io
TRUESYNC_TENANT_TOKEN=
