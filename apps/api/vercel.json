{
  "version": 2,
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "^/(.*)$",
      "has": [{ "type": "host", "value": "audit.parleo.io" }],
      "status": 308,
      "headers": { "Location": "https://parleo.io/audit/$1" }
    },
    {
      "src": "^/audit/?$",
      "dest": "/audit.html"
    },
    {
      "src": "^/audit/(r/.*|s/.*)$",
      "dest": "/audit-report.html"
    },
    {
      "src": "^/audit/robots\\.txt$",
      "dest": "/audit-robots.txt"
    },
    {
      "src": "^/audit/sitemap\\.xml$",
      "dest": "/audit-sitemap.xml"
    },
    {
      "src": "^/audit/((?:assets|og)/.*)$",
      "dest": "/$1"
    },
    {
      "src": "^/audit/([^/]+\\.(?:png|svg|ico|webmanifest|json|txt|xml|webp|avif|woff2?|ttf))$",
      "dest": "/$1"
    },
    {
      "src": "^/audit(/.*)?$",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/audit(/.*)?$",
      "status": 404
    },
    {
      "src": "^/scan(/.*)?$",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
