# Supabase POOLED connection (required for Vercel)
# Use the "Transaction" pooler URL from Supabase
# Dashboard → Project → Database → Connection Pooling
# Append: ?pgbouncer=true&connection_limit=1
DATABASE_URL_POOLED=postgresql://user:pass@db.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1

# Fallback direct URL for local dev
DATABASE_URL=postgresql://user:pass@db.supabase.co:5432/postgres

# Must be true for Vercel serverless
USE_POOLED_DB=true

# Optional — powers NewCycleFlow's competitor auto-suggestion
# (app/services/competitor_suggestion.py). Unset degrades gracefully to
# manual-only competitor entry; nothing else in apps/api uses this key.
OPEN_AI_API_KEY=

# ── Merchant Command Center (TrueSync) ────────────────────────────────
# The supply app's syndication API. The page reads it directly from the
# browser (it allows any origin on GET); only mutations go through this
# app's proxy — app/routers/truesync.py.
# The frontend needs the same base URL under VITE_TRUESYNC_API_BASE
# (web/.env.local); both default to https://api.parleo.io when unset.
TRUESYNC_API_BASE=https://api.parleo.io

# Server-side ONLY. The tenant token (issued by parleo-supply-app's
# scripts/tenants.py), sent as X-TrueSync-Key on every proxied TrueSync
# read and write and never exposed to the browser. Required: the upstream
# refuses scoped routes without it, and the Command Center shows "Not
# authorized for this customer". TRUESYNC_ADMIN_KEY is still read as a
# fallback until Step 1C.
TRUESYNC_TENANT_TOKEN=

# ── SoA Lite public intake rate limits (app/routers/public_lite.py) ───
# Positive integers; unset/empty/invalid falls back to these defaults.
# Max SoA Lite submissions per IP per rolling hour.
RATE_LIMIT_PER_IP_HOUR=3
# Max SoA Lite submissions per IP per rolling day.
RATE_LIMIT_PER_IP_DAY=10
# Max SoA Lite submissions across all IPs per rolling hour.
GLOBAL_RATE_LIMIT_PER_HOUR=20
