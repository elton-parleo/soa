# Supabase POOLED connection (required for Vercel)
# Use the "Transaction" pooler URL from Supabase
# Dashboard → Project → Database → Connection Pooling
# Append: ?pgbouncer=true&connection_limit=1
DATABASE_URL_POOLED=postgresql://user:pass@db.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1

# Fallback direct URL for local dev
DATABASE_URL=postgresql://user:pass@db.supabase.co:5432/postgres

# Must be true for Vercel serverless
USE_POOLED_DB=true
